{{define "bookmark-item" }}
    {{with .Bookmark}}
    <div id="bookmark-view" class="bookmark-list">
		<div class="bookmark">
			  <a class="bookmark-link" href="/bookmark/view/{{.ID}}">
				<div class="title">{{.Title}} </div>
			  
			  </a>

			  <time datetime="{{.Created}}">{{humanDate .Created}}</time>

			  <div class="summary">{{.Url}}</div>

			  <div class="bookmark-footer">
			  <span class="read-indicator">{{if .Read}}read{{else}}unread{{end}}</span>
			  </div>

			  <span class="bookmark-tags">
				  {{range .Tags}}
				  <span class="bookmark-tag">#{{.Name}}</span>&nbsp;
				  {{end}}
			  </span>
		</div>
    </div>
      {{if .Read}}
      <a href="" hx-target="#bookmark-view" hx-post="/bookmark/markunread" hx-vals='{"id": "{{.ID}}", "csrf_token": "{{$.CSRFToken}}"}'>mark unread</a>
      {{else}}
      <a href="" hx-target="#bookmark-view" hx-post="/bookmark/markread" hx-vals='{"id": "{{.ID}}", "csrf_token": "{{$.CSRFToken}}"}'>mark read</a>
      {{end}}
    <div class="article-content">
      {{.Content}}
    </div>
    <div class='metadata'>
      <!-- Use the new template function here -->
      <time>Created: {{humanDate .Created}}</time>
    </div>
    {{end}}
{{end}}
