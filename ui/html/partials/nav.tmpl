{{define "nav"}}
<header class="navbar" data-overflow-nav="">
  <nav class="contents">
    <p class="float:left">
      <a href="/" class="allcaps">Cardamom</a> 
    </p>
    <ul role="list">
      <li><a href='/'>Home</a></li>
      {{if .IsAuthenticated}}
        <li><a href='/bookmark/create'>Create bookmark</a></li>
      {{end}}
      {{if .IsAuthenticated}}
        <li><form action='/user/logout' method='POST'>
              <!-- Include the CSRF token -->
              <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
              <button>Logout</button>
          </form></li>
      {{else}}
        <li><a href='/user/signup'>Signup</a></li>
        <li><a href='/user/login'>Login</a></li>
      {{end}}
    </ul>
  </nav>
</header>
{{end}}
