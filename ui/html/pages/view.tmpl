{{define "title"}}Bookmark #{{.Bookmark.ID}}{{end}}

{{define "main"}}
    {{with .Bookmark}}
        <div class="bookmark-list">
          <div class="bookmark">
            <div class="bookmark-link">
              <div class="title">{{.Title}}</div>
            </div>

            <time datetime="{{.Created}}">{{humanDate .Created}}</time>

            <div class="summary">{{.Url}}</div>

            <div class="bookmark-footer">
			{{if .Read}}
			<a href="">mark unread</a>
			{{else}}
			<a href="">mark read</a>
			{{end}}
			<br>
			</div>

            <span class="bookmark-tags">
				{{range .Tags}}
				<span class="bookmark-tag">#{{.Name}}</span>&nbsp;
				{{end}}
            </span>
          </div>
	  </div>
        <div class="article-content">
          {{.Content}}
        </div>
        <div class='metadata'>
            <!-- Use the new template function here -->
            <time>Created: {{humanDate .Created}}</time>
        </div>
    {{end}}
{{end}}
