{{define "title"}}Bookmark #{{.Bookmark.ID}}{{end}}

{{define "main"}}
    {{with .Bookmark}}
    <div class='snippet'>
        <div class='metadata'>
            <strong>{{.Title}}</strong>
            <span>#{{.ID}}</span>
        </div>
        <div class='metadata'>
            <strong>{{.Url}}</strong>
        </div>
        <div class="article-content">
          {{.Content}}
        </div>
        <div class='metadata'>
            <!-- Use the new template function here -->
            <time>Created: {{humanDate .Created}}</time>
        </div>
    </div>
    {{end}}
{{end}}
