{{define "title"}}Bookmark #{{.Bookmark.ID}}{{end}}

{{define "main"}}
    {{with .Bookmark}}
    <div class='snippet'>
        <div class='metadata'>
            <strong>{{.Title}}</strong>
            <span>#{{.ID}}</span>
            <br>
			{{range .Tags}}
            <a class="bookmark-tag" href="./tags.html#pkm">#{{.Name}}</a>&nbsp;
			{{end}}
        </div>
        <div class='metadata'>
            <a href="{{.Url}}" target="_blank">{{.Url}}</a>
        </div>
        <div class="article-content">
          {{.Content}}
        </div>
        <div class='metadata'>
            <!-- Use the new template function here -->
            <time>Created: {{humanDate .Created}}</time>
        </div>
    </div>
    {{end}}
{{end}}
