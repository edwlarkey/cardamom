{{define "title"}}{{.Tag.Name}} - Cardamom{{end}}

{{define "main"}}
    <h2>Bookmarks for {{.Tag.Name}}</h2>
    <a href="" hx-target="body" hx-push-url="/" hx-post="/tag/delete/{{.Tag.ID}}" hx-vals='{"csrf_token": "{{$.CSRFToken}}"}' hx-confirm="Are you sure you want to delete this tag? Bookmarks will be untagged, not deleted.">delete {{.Tag.Name}}</a>
    {{if .Bookmarks}}
    <div class="bookmark-list" hx-boost="true">
      {{range .Bookmarks}}
      <div class="grid grid-even-rows box bookmark bookmark-meta">
        <div data-cols="1 8" data-rows="1">
          <a class="bookmark-link" href="/bookmark/view/{{.ID}}">
            <span class="title">{{.Title}} </span>
          </a>
          </div>

        <div data-cols="9 12" data-rows="1" style="text-align:right;">
          <time datetime="{{.Created}}">{{humanDate .Created}}</time>
          </div>

          <div data-cols="1 12" data-rows="2" class="summary">{{.Url}}</div>

        <div data-cols="1 7" data-rows="3">
          {{range .Tags}}
          <span class="bookmark-tag">#{{.Name}}</span>&nbsp;
          {{end}}
        </div>

        <div data-cols="8 12" data-rows="3" style="text-align:right;">
          <span class="read-indicator">{{if .Read}}read{{else}}unread{{end}}</span>
        </div>
      </div>
      {{end}}
    </div>
    {{else}}
        <p>There's nothing to see here... yet!</p>
    {{end}}
{{end}}
