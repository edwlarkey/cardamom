{{define "title"}}Create a New Bookmark{{end}}

{{define "main"}}
<div class="box margin grid grid-even-rows">
	<div class="box">
  <form action="/bookmark/create" class="table rows" method="POST" >
      <!-- Include the CSRF token -->
      <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
      <div>
          <label>Title:</label>
          <input type="text" name="title" value="{{.Form.Title}}">
      </div>
      <div>
          <label>URL:</label>
          <input type="text" name="url" value="{{.Form.Url}}">
          {{with .Form.FieldErrors.url}}
            <mark>{{.}}</mark>
          {{end}}
      </div>

      <div >
      <label>Tags:</label>
      <ul id="create-tag-options" hx-get="/tag/list" hx-trigger="load">
      </ul>
      </div>

      <div>
          <input type="submit" value="Add Bookmark">
      </div>
  </form>
  </div>

  <div class="box">
	  Add Tag
	  <form class="table rows" hx-post="/tag/create" hx-target="#create-tag-options">
		  <!-- Include the CSRF token -->
		  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
		  <div>
        <label>Name:</label>
        <input type="text" name="name">
		  </div>
		  <div>
			  <input type="submit" value="Add Tag">
		  </div>
	  </form>
  </div>
</div>
{{end}}
